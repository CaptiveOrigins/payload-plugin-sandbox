{
  "name": "@captiveorigins/payload-plugin-seed",
  "version": "0.3.0",
  "description": "Seed for Payload: realistic test data at scale, written with Claude",
  "homepage": "https://github.com/CaptiveOrigins/payload-plugin-seed#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/payload-plugin-seed/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "seed",
    "fake-data",
    "test-data",
    "pairwise",
    "seeding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/payload-plugin-seed.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./rsc": {
      "types": "./dist/rsc/index.d.ts",
      "import": "./dist/rsc/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test:unit",
    "test:unit": "vitest run test/core.test.ts"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@payloadcms/next": "^3.80.0",
    "@payloadcms/ui": "^3.80.0",
    "next": ">=15",
    "payload": "^3.80.0",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "graphql": "^16.14.2",
    "next": "16.4.5",
    "payload": "3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
